# Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Database (Docker local connection string)
DATABASE_URL="postgresql://insightsrank_user:insightsrank_dev_password@localhost:5432/insightsrank?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Security Secrets (JWT)
JWT_ACCESS_SECRET="insightsrank_dev_access_secret_key_change_in_production_32char"
JWT_REFRESH_SECRET="insightsrank_dev_refresh_secret_key_change_in_production_32char"
JWT_EXPIRES_IN="15m"

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"

# Frontend Integration URL
FRONTEND_URL="http://localhost:3000"
